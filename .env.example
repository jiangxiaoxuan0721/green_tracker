# =============================================================================
# 环境配置示例文件 - Green Tracker 项目
# =============================================================================
# 使用说明：
# 1. 复制此文件为 .env 并根据实际情况填写配置
# 2. 请勿将包含敏感信息的 .env 文件提交到版本控制系统

# =============================================================================
# 应用基础配置
# =============================================================================

# 应用环境 (development, production)
NODE_ENV=development

# =============================================================================
# 站点域名与 HTTPS 配置
# =============================================================================
# 部署域名（默认访问地址：https://green-tracker.cn）
# 配合 scripts/setup_https.sh 自动申请 Let's Encrypt 证书
DOMAIN=green-tracker.cn

# SSL 证书邮箱（Let's Encrypt 注册用，建议用真实邮箱接收续期提醒）
SSL_EMAIL=admin@green-tracker.cn

# =============================================================================
# 前端服务器配置
# =============================================================================

# 前端服务器端口（仅本地监听，由 Nginx 反向代理对外提供 https）
PORT=3010

# 前端API请求基础URL（origin 前缀，不含 /api）
# 推荐留空：同源相对路径，开发由 Vite proxy、生产由 Nginx 反代 /api，保证 HTTPS 无跨域问题
# 仅在必须直连后端时改为完整 origin，例如 https://green-tracker.cn:6130
# 注意：不要填写 /api，因为代码中请求路径已自带 /api 前缀，否则会变成 /api/api/...
VITE_API_BASE_URL=

# =============================================================================
# 前端环境变量配置 (Vite)
# =============================================================================

# 高德地图API配置
# 申请地址: https://console.amap.com/dev/key/app
VITE_AMAP_KEY=your_amap_web_js_key
VITE_AMAP_SERVICE_KEY=your_amap_service_key

# MinIO前端配置
VITE_MINIO_ENDPOINT=your-domain.com
VITE_MINIO_PORT=9100
VITE_MINIO_BUCKET=your-bucket-name
VITE_MINIO_SECURE=false
# 推荐使用相对路径 /minio/<bucket>（由 Nginx 反代到 MinIO，避免端口号暴露）
# 仅在必须直连 MinIO 时改为完整 URL，例如 https://your-domain.com/minio/your-bucket-name
VITE_MINIO_PUBLIC_URL=/minio/your-bucket-name

# API超时配置
VITE_API_TIMEOUT=30000

# 图像处理配置
VITE_THUMBNAIL_SIZE=150
VITE_IMAGE_LAZY_LOADING=true
# 算法压缩包上限（字节，默认 1 GB = 1073741824；按需下调）
# 前端校验使用；后端 nginx client_max_body_size 0 不再二次限制
VITE_MAX_FILE_SIZE=1073741824
VITE_ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp,bmp

# 缓存配置
VITE_THUMBNAIL_CACHE_TTL=3600
VITE_IMAGE_CACHE_LIMIT=100

# 性能配置
VITE_ENABLE_VIRTUAL_SCROLL=false
VITE_PAGE_SIZE=20
VITE_MAX_CONCURRENT_REQUESTS=5


# 允许的主机列表（逗号分隔）
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# 后端API配置
# =============================================================================

# API服务器主机配置
# 0.0.0.0 = 监听所有接口（便于本地调试）
# 127.0.0.1 = 仅本地监听（生产建议，由 Nginx 反向代理转发）
API_HOST=127.0.0.1
API_PORT=6130

# 后端是否启用 HTTPS（一般不需要，Nginx 已经做了 HTTPS 终结）
BACKEND_USE_HTTPS=false
# BACKEND_SSL_CERTFILE=
# BACKEND_SSL_KEYFILE=

# JWT认证配置
# 注意：在生产环境中请使用强随机密钥（至少32位）
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =============================================================================
# 数据库配置 (PostgreSQL)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 元数据库名称（固定，用于存储用户、数据库等元数据）
META_DB_NAME=green_tracker_meta
TEMPLATE_DB_NAME=green_tracker_template
USER_DB_PREFIX=green_tracker_user_

# 超级用户配置（用于创建数据库）
DB_SUPERUSER=postgres
DB_SUPERPASSWORD=your_superuser_password

# 数据库连接池配置（可选）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# 对象存储配置 (MinIO)
# =============================================================================

# MinIO连接配置
MINIO_BUCKET_NAME=your-bucket-name
MINIO_ENDPOINT=your-domain.com
MINIO_PORT=9100
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# MinIO安全配置（生产环境建议启用https）
MINIO_SECURE=false

# =============================================================================
# 日志配置
# =============================================================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径（可选，默认为控制台输出）
LOG_FILE_PATH=logs

# =============================================================================
# CORS配置
# =============================================================================

# 允许的源（逗号分隔，请根据实际部署域名修改）
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# 允许的方法（逗号分隔）
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# 允许的头部（逗号分隔）
CORS_HEADERS=Content-Type,Authorization

# =============================================================================
# 文件上传配置
# =============================================================================

# 最大文件上传大小（字节，默认 1 GB = 1073741824；当前后端未消费，仅文档占位）
MAX_UPLOAD_SIZE=1073741824

# 允许的文件类型（逗号分隔）
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt,zip,xls,xlsx

# =============================================================================
# Docker配置 (算法镜像构建)
# =============================================================================
# 注意：算法构建功能需要Docker支持，请先运行 scripts/docker-install.sh 安装Docker

# Docker镜像仓库地址（用于存储算法镜像）
# 开发环境：localhost:5000
# 生产环境：建议使用私有镜像仓库如 Harbor、阿里云ACR等
DOCKER_REGISTRY=localhost:5000

# 算法容器端口范围（避免与其他服务冲突）
ALGORITHM_PORT_START=8000
ALGORITHM_PORT_END=9000

# 镜像构建超时时间（秒）
DOCKER_BUILD_TIMEOUT=600

# 容器内存限制（默认4g）
CONTAINER_MEMORY_LIMIT=4g

# 镜像清理策略（可选）
# DOCKER_CLEANUP_DAYS=30  # 自动清理超过指定天数的旧镜像

# =============================================================================
# MQTT 配置 (设备通信)
# =============================================================================

# MQTT Broker 连接配置
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# MQTT Broker 管理员账号（云端服务器用）
MQTT_USERNAME=admin
MQTT_PASSWORD=admin123

# MQTT WebSocket 端口（前端直连 Monitor 用）
MQTT_WS_PORT=9001

# MQTT 日志级别 (DEBUG/INFO/WARNING/ERROR)
MQTT_LOG_LEVEL=INFO

# MQTT 服务端口（docker-compose 用）
MQTT_PORT=1883
SERVER_PORT=8080

# =============================================================================
# HTTPS / 反向代理部署说明
# =============================================================================
# 推荐架构（不区分开发 / 生产）：
#   浏览器 → Nginx (:80/:443)
#              ├── /          → Vite dev server / 静态资源
#              └── /api/      → FastAPI (仅本地监听 127.0.0.1:6130)
#
# 一键配置 HTTPS 证书（自动选择 Let's Encrypt 或自签名）：
#   make setup-https
#
# 详细文档见 docs/HTTPS_SETUP.md

# =============================================================================
# 邮件服务配置 (SMTP)
# =============================================================================

# SMTP服务器地址（QQ邮箱: smtp.qq.com, Gmail: smtp.gmail.com）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# SMTP账号和密码（QQ邮箱需使用授权码，在QQ邮箱设置中生成）
SMTP_USER=123456790@qq.com
SMTP_PASSWORD=88888888
# 发件人显示名称
SMTP_FROM_NAME=Green_Tracker
